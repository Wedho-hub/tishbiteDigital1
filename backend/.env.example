NODE_ENV=production
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed browser origins
# Example: https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=https://your-app.vercel.app

# Use "none" when frontend and backend are on different domains (Vercel + Render)
# Use "strict" when served from same site/domain
COOKIE_SAMESITE=none

# ── PayFast ─────────────────────────────────────────────────────────────────
# Get these from your PayFast merchant dashboard: https://www.payfast.co.za
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
# Set a passphrase in your PayFast account settings and paste it here
PAYFAST_PASSPHRASE=your_payfast_passphrase
# Set to "true" to use the PayFast sandbox for testing
PAYFAST_SANDBOX=false

# Public URLs used for PayFast redirect and notify callbacks
FRONTEND_URL=https://tishbitedigital.co.za
BACKEND_URL=https://tishbitedigital.co.za
