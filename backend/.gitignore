# Dependencies
node_modules/

# Environment files & secrets
# Note: .env.example IS intentionally committed (shows required vars)
.env
.env.*
!.env.example

# SSL / TLS keys and certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Build outputs
dist/
build/

# User-uploaded content (local dev only; production uses cloud storage)
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
coverage/
test-results/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
