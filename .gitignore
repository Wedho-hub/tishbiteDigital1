# ============================================================
# ROOT — covers the entire monorepo
# Each subdirectory (frontend/, backend/) has its own
# .gitignore for framework-specific rules.
# ============================================================

# Dependencies
node_modules/

# Environment & secrets — belt-and-suspenders at monorepo root
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# SSL / TLS keys and certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Local cookies / session test artifacts
cookies.txt

# Build outputs
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User-uploaded content (local dev only; production uses cloud storage)
uploads/

# Test coverage
coverage/
test-results/
.nyc_output/

# Deployment tool caches
.vercel/
.render/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
